# Brevo is used for transactional invoice email delivery.
# Create an API key and verify the sender address/domain before sending mail.
BREVO_API_KEY=xkeysib-your_api_key_here
BREVO_FROM_EMAIL=invoices@your-verified-domain.com
BREVO_FROM_NAME=Ledgerly

# Demo login. Change all three values before a production deployment.
AUTH_EMAIL=demo@ledgerly.app
AUTH_PASSWORD=ledgerly2026
AUTH_SECRET=replace-with-a-long-random-secret
